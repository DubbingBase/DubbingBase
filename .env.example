# Supabase Local
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# APIs
TMDB_API_KEY=
TVDB_API_KEY=
GOOGLE_AI_KEY=
GROQ_API_KEY=

# Nuxt Server (prefixed with NUXT_ for runtimeConfig)
NUXT_GOOGLE_AI_KEY=
NUXT_GROQ_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=your-recipient-email@example.com

# OneSignal (Push Notifications)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# App Environment
NODE_ENV=development

# Mobile App (Vite/Capacitor)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ONESIGNAL_APP_ID=
# Nitro product API (website). Defaults to https://dubbingbase.com if unset.
VITE_API_BASE_URL=https://dubbingbase.com

# Android Build Variables
JAVA_HOME=
ANDROID_HOME=
NDK_HOME=
KEY_ALIAS=
KEY_PASSWORD=
KEYSTORE_PASSWORD=

# Discord
DISCORD_ADMIN_WEBHOOK_LOG_URL=
