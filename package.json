{
  "name": "dubbing-base-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@app/mobile",
    "build:website": "turbo run build --filter=@app/website",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.9.1",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.14.2",
  "workspaces": ["apps/*", "packages/*"]
}