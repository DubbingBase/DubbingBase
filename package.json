{
  "name": "dubbing-base-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:website": "turbo run build --filter=@app/website",
    "dev": "turbo run dev",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test",
    "discover:media": "npx --yes tsx --env-file=.env.development scripts/discover-media.ts",
    "i18n:check": "node scripts/check-i18n.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "^2.11.11",
    "vue-i18n-extract": "^2.0.7",
    "wrangler": "^4.160.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "oxlint --fix -c .oxlintrc.json --vue-plugin",
      "oxfmt --write"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx|*.vue)": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.4.1",
  "pnpm": {
    "overrides": {
      "vue": "3.5.45",
      "@vue/runtime-core": "3.5.45",
      "@vue/runtime-dom": "3.5.45",
      "@vue/reactivity": "3.5.45",
      "@vue/compiler-core": "3.5.45",
      "@vue/compiler-dom": "3.5.45",
      "@vue/compiler-sfc": "3.5.45",
      "@vue/compiler-ssr": "3.5.45",
      "@vue/server-renderer": "3.5.45",
      "@vue/shared": "3.5.45"
    },
    "packageExtensions": {
      "vue-sonner": {
        "peerDependencies": {
          "nuxt": "-"
        }
      }
    }
  }
}
