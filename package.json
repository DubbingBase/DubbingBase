{
  "name": "dubbing-base-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@app/mobile",
    "build:website": "turbo run build --filter=@app/website",
    "dev": "turbo run dev",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "discover:media": "npx --yes tsx --env-file=.env.development scripts/discover-media.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "wrangler": "^4.115.0"
  },
  "packageManager": "pnpm@9.14.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
