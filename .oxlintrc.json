{
  "plugins": ["typescript"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/no-useless-empty-export": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "scripts/**",
        "apps/website/scripts/**",
        "apps/website/tests/**",
        "e2e/**",
        "packages/database/*.ts",
        "packages/database/benchmarks/**"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/await-thenable": "off"
      }
    },
    {
      "files": [
        "apps/website/server/middleware/00-e2e-mock.ts",
        "apps/website/server/utils/llm.ts",
        "apps/website/server/utils/services/media.ts",
        "apps/website/src/composables/useEditorFormState.ts",
        "apps/website/src/plugins/authenticated-fetch.ts",
        "apps/website/src/plugins/chunk-error-handler.client.ts",
        "apps/website/src/plugins/posthog.client.ts",
        "apps/website/src/utils/voice-actor-profile-save.ts",
        "packages/og-image/src/index.ts",
        "packages/og-image/src/voice-actor.ts",
        "packages/shared-logic/src/composables/useDetailCollections.ts"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/await-thenable": "off"
      }
    }
  ]
}
