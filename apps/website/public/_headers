/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/offline.html
  Cache-Control: public, max-age=86400

/offline
  Cache-Control: public, max-age=86400

/favicon-96x96.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon-16x16.png
  Cache-Control: public, max-age=604800

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/android-chrome-192x192.png
  Cache-Control: public, max-age=604800

/android-chrome-512x512.png
  Cache-Control: public, max-age=604800

/logo2.png
  Cache-Control: public, max-age=604800

# Content-hashed i18n bundles never change under the same URL.
/_i18n/*
  Cache-Control: public, max-age=31536000, immutable

# Prerendered About pages and their light-theme variants change only on deploy.
/about/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/about.light
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/fr/about/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/fr/about.light
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/es/about/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/es/about.light
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/ja/about/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/ja/about.light
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
